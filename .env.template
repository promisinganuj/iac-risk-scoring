# Copy this file to .env (same folder) and adjust values as needed.
#   cp .env.template .env

# Neo4j credentials
NEO4J_PASSWORD=<please-change-me>

# Neo4j connection info (used by the Neo4j MCP server config in .vscode/mcp.json)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# Local ports exposed on your machine
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Kusto authentication (required for --data-source kusto or hybrid)
# az_cli  = Azure CLI credential (local dev on corpnet)
# mi      = Managed Identity (production / AKS)
# default = DefaultAzureCredential (tries all methods)
# KUSTO_AUTH_METHOD=az_cli
