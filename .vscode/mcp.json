{
  "servers": {
    "neo4j-database": {
      "command": "uvx",
      "args": [ "mcp-neo4j-cypher@0.5.2", "--transport", "stdio"  ],
      "env": {
        "NEO4J_URI": "${env:NEO4J_URI}",
        "NEO4J_USERNAME": "${env:NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${env:NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "${env:NEO4J_DATABASE}"
      }
    },
    "beads": {
      "type": "stdio",
      "command": "/Users/anuj/002-GitHub/iac-risk-scoring/.venv/bin/beads-mcp",
      "args": [],
      "env": {
        "BEADS_WORKING_DIR": "/Users/anuj/002-GitHub/iac-risk-scoring"
      }
    }
  }
}
