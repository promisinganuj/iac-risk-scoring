{
  "servers": {
    "neo4j-database": {
      "command": "$HOME/.local/bin/uvx",
      "args": [ "--native-tls", "mcp-neo4j-cypher@0.5.2", "--transport", "stdio"  ],
      "envFile": "${workspaceFolder}/approach2-using-existing-graph/.env"
    },
    "beads": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/beads-mcp",
      "args": [],
      "env": {
        "BEADS_WORKING_DIR": "${workspaceFolder}"
      }
    }
  }
}
