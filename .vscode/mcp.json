{
  "servers": {
    "neo4j-database": {
      "command": "/home/anuj/.local/bin/uvx",
      "args": [
        "--native-tls",
        "--with", "fastmcp>=2.10.5,<2.18",
        "mcp-neo4j-cypher@0.5.2",
        "--transport", "stdio"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    "beads": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/beads-mcp",
      "args": [],
      "env": {
        "BEADS_WORKING_DIR": "${workspaceFolder}"
      }
    },
    "risk-scoring": {
      "command": "${workspaceFolder}/.venv/bin/python3",
      "args": ["-m", "risk_scoring.mcp_server"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
