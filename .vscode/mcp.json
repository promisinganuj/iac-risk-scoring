{
  "servers": {
    "neo4j-database": {
      "command": "uvx",
      "args": [ "--native-tls", "mcp-neo4j-cypher@0.5.2", "--transport", "stdio"  ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "${env:NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${env:NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "${env:NEO4J_DATABASE}"
      },
      "envFile": "${workspaceFolder}/approach2-using-existing-graph/.env"
    },
    "beads": {
      "type": "stdio",
      "command": "/Users/anuj/002-GitHub/iac-risk-scoring/.venv/bin/beads-mcp",
      "args": [],
      "env": {
        "BEADS_WORKING_DIR": "${workspaceFolder}"
      }
    }
  }
}
